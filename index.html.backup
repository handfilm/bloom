<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOOM — Private Gape Vault</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0a0a0a; color: #ededed; }
        .card { transition: all 0.3s; }
        .card:hover { transform: scale(1.05); box-shadow: 0 0 30px rgba(236, 72, 153, 0.4); }
        .viewer { animation: fadeIn 0.4s; }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
    </style>
</head>
<body class="min-h-screen pb-24">
    <div class="max-w-7xl mx-auto p-6">
        <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
            <div>
                <h1 class="text-5xl font-bold tracking-tighter text-white">BLOOM</h1>
                <p class="text-pink-500">SOLO FEMALE • ANAL GAPE CURATION</p>
            </div>
            
            <div class="flex flex-wrap gap-3">
                <button onclick="setCollection('all')" class="collection-btn active px-5 py-2.5 rounded-2xl border border-zinc-700 hover:bg-zinc-900">ALL</button>
                <button onclick="setCollection('favorites')" class="collection-btn px-5 py-2.5 rounded-2xl border border-zinc-700 hover:bg-zinc-900">❤️ FAV</button>
                <button onclick="setCollection('sexcanal')" class="collection-btn px-5 py-2.5 rounded-2xl border border-zinc-700 hover:bg-zinc-900">SEXCANAL</button>
                <button onclick="setCollection('mywife')" class="collection-btn px-5 py-2.5 rounded-2xl border border-zinc-700 hover:bg-zinc-900">MY WIFE</button>
                
                <button onclick="surpriseMe()" class="bg-white text-black px-6 py-3 rounded-2xl font-medium flex items-center gap-2">🎲 SURPRISE ME</button>
                <button onclick="document.getElementById('upload').click()" class="border border-zinc-700 hover:bg-zinc-900 px-6 py-3 rounded-2xl">📤 BULK IMPORT</button>
            </div>
        </div>

        <input type="file" id="upload" multiple accept="image/*,video/*" class="hidden" onchange="handleUpload(event)">

        <div id="gallery" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6"></div>
    </div>

    <!-- Viewer -->
    <div id="viewer" class="hidden fixed inset-0 bg-black/95 z-50 flex items-center justify-center p-4" onclick="closeViewer(event)">
        <div class="max-w-4xl w-full" onclick="event.stopImmediatePropagation()">
            <button onclick="closeViewer()" class="absolute top-6 right-6 bg-red-600 text-white w-12 h-12 rounded-full text-2xl">✕</button>
            <img id="viewerImage" class="w-full rounded-3xl shadow-2xl" alt="">
            <div class="mt-6 flex justify-center items-center gap-8">
                <div onclick="toggleFavorite()" id="favBtn" class="text-4xl cursor-pointer">♡</div>
                <input id="scoreInput" type="number" min="1" max="100" class="bg-zinc-900 text-6xl font-bold text-pink-500 w-32 text-center rounded-2xl py-2" onchange="updateScore()">
                <button onclick="deleteCurrent()" class="text-red-500 text-xl">🗑️ DELETE</button>
            </div>
        </div>
    </div>

    <script>
        let items = JSON.parse(localStorage.getItem('bloomItems')) || [];
        let currentFilter = 'all';
        let currentViewerIndex = -1;

        function saveToLocal() {
            localStorage.setItem('bloomItems', JSON.stringify(items));
        }

        function renderGallery() {
            const gallery = document.getElementById('gallery');
            gallery.innerHTML = '';
            
            const filtered = items.filter(item => {
                if (currentFilter === 'all') return true;
                if (currentFilter === 'favorites') return item.favorite;
                return item.collection === currentFilter;
            });

            filtered.forEach((item, idx) => {
                const div = document.createElement('div');
                div.className = `card bg-zinc-900 rounded-3xl overflow-hidden cursor-pointer border border-zinc-800 relative`;
                div.innerHTML = `
                    <img src="${item.url}" class="w-full aspect-[4/3] object-cover">
                    <div class="p-4">
                        <div class="flex justify-between items-center">
                            <div class="text-4xl font-bold text-pink-500">${item.score}</div>
                            ${item.favorite ? '<span class="text-red-500">❤️</span>' : ''}
                        </div>
                        <div class="text-xs text-zinc-400 mt-1">${item.name || 'Untitled'}</div>
                    </div>
                `;
                div.onclick = () => showViewer(idx);
                gallery.appendChild(div);
            });
        }

        function showViewer(idx) {
            currentViewerIndex = idx;
            const item = items[idx];
            document.getElementById('viewerImage').src = item.url;
            document.getElementById('scoreInput').value = item.score;
            document.getElementById('favBtn').textContent = item.favorite ? '❤️' : '♡';
            document.getElementById('viewer').classList.remove('hidden');
        }

        function closeViewer() {
            document.getElementById('viewer').classList.add('hidden');
        }

        function updateScore() {
            if (currentViewerIndex === -1) return;
            items[currentViewerIndex].score = parseInt(document.getElementById('scoreInput').value) || 75;
            saveToLocal();
            renderGallery();
        }

        function toggleFavorite() {
            if (currentViewerIndex === -1) return;
            items[currentViewerIndex].favorite = !items[currentViewerIndex].favorite;
            document.getElementById('favBtn').textContent = items[currentViewerIndex].favorite ? '❤️' : '♡';
            saveToLocal();
            renderGallery();
        }

        function deleteCurrent() {
            if (currentViewerIndex === -1 || !confirm('ডিলিট করতে চাও?')) return;
            items.splice(currentViewerIndex, 1);
            saveToLocal();
            closeViewer();
            renderGallery();
        }

        function surpriseMe() {
            if (items.length === 0) return alert("কোনো ছবি নেই!");
            const random = Math.floor(Math.random() * items.length);
            showViewer(random);
        }

        function handleUpload(e) {
            const files = e.target.files;
            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(ev) {
                    const newItem = {
                        id: Date.now(),
                        url: ev.target.result,
                        score: 75,
                        name: file.name,
                        favorite: false,
                        collection: 'all'
                    };
                    items.unshift(newItem);
                    saveToLocal();
                    renderGallery();
                };
                reader.readAsDataURL(file);
            });
        }

        function setCollection(coll) {
            currentFilter = coll;
            document.querySelectorAll('.collection-btn').forEach(btn => btn.classList.remove('active', 'bg-pink-600', 'text-white'));
            renderGallery();
        }

        // Init
        window.onload = () => {
            renderGallery();
        };
    </script>
</body>
</html>
